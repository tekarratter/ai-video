{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "lib": ["DOM", "ES2023"],
    "paths": { "@custom": ["./workspace/custom/index.tsx"] }
  },
  "include": ["web/src", "remotion", "workspace/custom", "shared"]
}
