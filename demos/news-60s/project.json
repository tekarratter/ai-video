   "type": "audio",
   "duration": 4.299,
   "tts": {
    "text": "Vịnh Hạ Long ở Quảng Ninh là di sản thiên nhiên thế giới đầu tiên của Việt Nam.",
    "voice": "vi:Mai Anh",
    "speed": 1
   }
  },
  {
   "id": "aud_20dc5f5dc0",
   "name": "v_20dc5f5dc0.m4a",
   "path": "media/v_20dc5f5dc0.m4a",
   "type": "audio",
   "duration": 5.255,
   "tts": {
    "text": "Năm 1994, UNESCO ghi danh vịnh vì vẻ đẹp cảnh quan ngoại hạng.",
    "voice": "vi:Mai Anh",
    "speed": 1
   }
  },
  {
   "id": "aud_46dfcb0d24",
   "name": "v_46dfcb0d24.m4a",
   "path": "media/v_46dfcb0d24.m4a",
   "type": "audio",
   "duration": 4.365,
   "tts": {
    "text": "Đến năm 2000, vịnh được công nhận lần thứ hai nhờ giá trị địa chất, địa mạo.",
    "voice": "vi:Mai Anh",
    "speed": 1
   }
  },
  {
   "id": "aud_30d1b5ed58",
   "name": "v_30d1b5ed58.m4a",
   "path": "media/v_30d1b5ed58.m4a",
   "type": "audio",
   "duration": 4.102,
   "tts": {
    "text": "Vịnh có gần hai nghìn hòn đảo đá vôi lớn nhỏ, phần lớn chưa có người ở.",
    "voice": "vi:Mai Anh",
    "speed": 1
   }
  },
  {
   "id": "aud_f0896ae431",
   "name": "v_f0896ae431.m4a",
   "path": "media/v_f0896ae431.m4a",
